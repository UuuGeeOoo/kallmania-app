generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// KALLMANIA — SBTS Group Multi-Team Task Management,
// KPI Tracking & Intelligent Report Consolidation System
// ─────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String
  // Roles: ADMIN | SUPERVISOR | TEAM_LEAD | AGENT_BPO | DEVELOPER | SOCIAL_MEDIA
  role         String    @default("AGENT_BPO")
  // Departments: BPO | WEB_DEV | SOCIAL_MEDIA | MANAGEMENT
  department   String    @default("BPO")
  // Team under the BPO division: OUTBOUND | INBOUND | EMAIL | SOCIAL | TECH
  team         String?
  employeeId   String?
  phone        String?
  // Employment: FULL_TIME (standard 8-hour shift) | PART_TIME (fewer hours/days)
  employmentType String @default("FULL_TIME")
  // Working days as a 7-char mask Mon..Sun ("1" = works). "1111100" = Mon–Fri; positions 5-6 = weekend (Sat, Sun)
  workDays     String   @default("1111100")
  // Shift window, 24h HH:MM. Full-time default is the 8-hour shift 09:00–17:00
  shiftStart   String   @default("09:00")
  shiftEnd     String   @default("17:00")
  // Registration location (ISO-3166 country code + state/region name + optional city)
  country      String?
  state        String?
  city         String?
  // PENDING | APPROVED | REJECTED | SUSPENDED
  status       String    @default("PENDING")
  approvedAt   DateTime?
  approvedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  reports        Report[]       @relation("ReportOwner")
  reviewedReports Report[]      @relation("ReportReviewer")
  assignedTasks  Task[]         @relation("TaskAssignee")
  createdTasks   Task[]         @relation("TaskCreator")
  taskAssignments TaskAssignee[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  uploadedFiles  UploadedFile[]
  updatedTemplates ReportTemplate[] @relation("TemplateUpdater")
  notices        Notice[]       @relation("NoticeAuthor")
  escalationsSent     Escalation[] @relation("EscalationFrom")
  escalationsReceived Escalation[] @relation("EscalationTarget")
  memberKpiConfigs MemberKpiConfig[]
  pushSubscriptions PushSubscription[]
  pushEvents        PushEvent[]
  pushPreference    PushPreference?
  activityEvents    ActivityEvent[]
  sbtsEvents        SbtsEvent[]
  kpiResults        KpiResult[]     @relation("KpiResultOwner")
}

// ── Application activity tracking (Operational Intelligence module) ────────
// Meaningful, non-sensitive operational events recorded server-side so the
// administrative analytics can distinguish real work activity from logins.
// Never stores passwords, message contents, or other sensitive material.
// Sources: server route instrumentation (authoritative) + the existing
// AuditLog LOGIN rows (historical logins mined at report time).
model ActivityEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  // LOGIN | REPORT_CREATED | REPORT_DRAFT_SAVED | REPORT_DRAFT_RESUMED |
  // REPORT_SUBMITTED | REPORT_UPDATED | REPORT_REVIEWED | TASK_STATUS_CHANGED |
  // TASK_COMPLETED | ESCALATION_RAISED | ESCALATION_REPLIED | ESCALATION_RESOLVED |
  // NOTICE_ACKNOWLEDGED | UPLOAD_UPLOADED | UPLOAD_CONFIRMED
  eventType   String
  // Report | Task | Escalation | Notice | UploadedFile
  relatedType String?
  relatedId   String?
  // Author's centre/team snapshot — keeps historical scoping stable
  centreCountry String?
  centreState   String?
  team          String?
  metadata    String? // small JSON blob (e.g. { reportType, status })
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([createdAt])
}

// ── SBTS Media Command Centre integration (protocol v1) ─────────────────────
// The external SBTS Media Command Centre pushes agent performance scores and
// end-of-day reports as signed events. Every event is stored idempotently by
// its sender-supplied eventId (duplicates are skipped, never re-processed).
// Scoring is OWNED BY SBTS — Kallmania stores and displays, never recomputes.
model SbtsEvent {
  id         String    @id @default(cuid())
  // Sender-supplied unique event id — the idempotency key
  eventId    String    @unique
  // performance.score | daily.report (protocol v1)
  type       String
  // Agent identity as sent by SBTS — mapped to a Kallmania account by exact
  // (case-insensitive) email match at ingest time
  agentEmail String
  // The performance/report business date (YYYY-MM-DD)
  eventDate  String
  // performance.score fields (null for daily.report)
  score      Float?
  delta      Float?
  components String?   // JSON object { component: points }
  // daily.report fields (null for performance.score)
  report     String?
  // Sender timestamp (informational; freshness enforcement uses the signature headers)
  sentAt     DateTime?
  receivedAt DateTime  @default(now())
  // Matched Kallmania account at ingest time (null = unmapped email, kept for reconciliation)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  matched    Boolean   @default(false)
  // Exact raw JSON payload as received — audit/completeness, unknown fields preserved
  raw        String
  // Optional report template supplied alongside a daily.report (additive v1
  // extension): the template text the external site says the report follows.
  // Stored so the archive can show report + template together and reviewers
  // can spot a report that does not follow its stated template.
  reportTemplate String?
  // Normalized KPI records materialized from this event (SBTS-owned scores)
  kpiResults KpiResult[] @relation("KpiResultEvent")

  @@index([type, agentEmail, eventDate])
  @@index([agentEmail, receivedAt])
  @@index([eventDate])
  @@index([userId, receivedAt])
}

// Machine credentials for the SBTS ingest pipe. The bearer API key is stored
// ONLY as a SHA-256 hash (verification without plaintext); it is shown exactly
// once at generation/rotation. The HMAC secret is held server-side (it must be
// retrievable to verify signatures). Rotation mints a new credential and puts
// the old one into a grace window so the 24/7 pipe never breaks mid-rotation.
model SbtsCredential {
  id         String    @id @default(cuid())
  label      String    @default("SBTS Media Command Centre")
  keyHash    String    @unique // sha256 hex of the bearer key
  keyHint    String    // first4…last4 — identification only, never the key
  secret     String    // HMAC-SHA256 shared secret
  active     Boolean   @default(true)
  revokedAt  DateTime?
  graceUntil DateTime? // revoked credential still verifies until this instant
  createdAt  DateTime  @default(now())
}

// Handover deliverables served by /api/sbts/handover. Stored in the shared
// database (NOT the gitignored download/ directory) so every deployment of
// the app — including production hosts with an empty filesystem — serves the
// same bytes. Seeded by scripts/sbts-deliverables.ts.
model SbtsDeliverable {
  id        String   @id @default(cuid())
  name      String   @unique // "handover-pdf" | "roster-xlsx"
  mimeType  String
  bytes     Bytes
  sizeBytes Int
  updatedAt DateTime @updatedAt
}

// Self-service password reset — an agent who forgot their password asks from
// the login screen ("Forgot password?"); an administrator approves or denies
// the request in User Management; an approved request unlocks a ONE-TIME
// "set new password" form for that email on the login screen. No email is
// sent — the agent re-checks their request status on the same screen, and the
// in-app notification arrives once they can sign in again.
model PasswordResetRequest {
  id            String    @id @default(cuid())
  email         String
  userId        String? // the account the request resolved to, when it exists
  // PENDING | APPROVED | DENIED | USED
  status        String    @default("PENDING")
  requestedAt   DateTime  @default(now())
  decidedAt     DateTime?
  decidedById   String?
  decidedByName String?
  usedAt        DateTime?

  @@index([email, status])
  @@index([status, requestedAt])
}

// Individual (per-member) KPI configuration — overrides of the centre/global
// KPI targets for ONE staff member. Administrators and supervisors save
// directly as APPROVED; a team lead's edits stay PENDING until a supervisor
// or administrator approves them.
model MemberKpiConfig {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id])
  department String // BPO | INBOUND | WEB_DEV | SOCIAL_MEDIA
  key        String // metric key from the KPI catalogue
  label      String
  target     Float?
  unit       String  @default("count") // count | percent | minutes
  // PENDING | APPROVED | REJECTED
  status        String  @default("APPROVED")
  proposedById   String?
  proposedByName String?
  reviewedById   String?
  reviewedByName String?
  reviewNote     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, department, key])
  @@index([userId])
  @@index([status])
}

model Report {
  id         String   @id @default(cuid())
  ref        String   @unique
  // AGENT_BPO | TECH | SOCIAL | SUPERVISOR
  type       String
  reportDate DateTime
  userId     String
  user       User     @relation("ReportOwner", fields: [userId], references: [id])
  department String

  // ── Shared attendance block (agent & supervisor templates) ──
  shiftTime        String?
  clockIn          String?
  clockOut         String?
  attendanceStatus String? // Present / Late / Absent
  latenessMins     Int?

  // ── AGENT_BPO template ──
  // JSON: [{ key, label, target, actual, variance, unit, auto, notes, category, mandatory }]
  kpiMetrics           String?
  // JSON: [{ leadName, disposition, followUp, notes }]
  callLogs             String?
  challenges           String?
  escalations          String?
  additionalActivities String?
  // JSON: { campaignName, outstandingFollowUps, ... } — email campaign context
  emailContext         String?

  // ── TECH / SOCIAL structured entries ──
  // JSON: array of work/activity entries
  workEntries    String?
  // JSON: department aggregate metrics { key: value }
  metricsSummary String?

  // ── TEAM_LEAD dynamic template ──
  // JSON: { sections: { [sectionId]: string | number | Row[] } } rendered from ReportTemplate
  payload String?

  // ── SUPERVISOR template ──
  teamName          String?
  campusLocation    String?
  agentsManaged     Int?
  attendanceSummary String? // JSON
  teamKpiAverages   String? // JSON
  coachingEntries   String? // JSON
  qaObservations    String?
  escalatedIssues   String? // JSON
  highlights        String?
  lowlights         String?
  actionPlan        String? // JSON
  managerReview     String?

  // ── Workflow ──
  // DRAFT | SUBMITTED | APPROVED | REJECTED
  status             String    @default("DRAFT")
  supervisorFeedback String?
  reviewedById       String?
  reviewer           User?     @relation("ReportReviewer", fields: [reviewedById], references: [id])
  reviewedAt         DateTime?

  // ── Provenance ──
  // MANUAL | UPLOAD_EXTRACTED | CONSOLIDATED | SBTS_IMPORT
  sourceType   String  @default("MANUAL")
  sourceFileId String?
  // MANUAL_ENTRY | EXTRACTED_UNCONFIRMED | CONFIRMED_BY_EMPLOYEE | REVIEWED_BY_SUPERVISOR
  verificationStatus String @default("MANUAL_ENTRY")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Normalized KPI result records materialized from this report at submit time
  kpiResults KpiResult[] @relation("KpiResultSource")

  @@index([reportDate])
  @@index([userId])
  @@index([type, status])
}

// ── Normalized KPI result records ───────────────────────────────────────────
// The machine-readable KPI store: one row per (report|external event) × KPI,
// written automatically when a report is SUBMITTED (manual, upload-confirmed
// or team-lead payload) or when a matched SBTS score event lands. The
// dashboards keep deriving trends from the reports at read time; these rows
// are the per-KPI audit trail that links every actual value back to its
// source (report ref, SBTS event id), period, target and verification state.
// A duplicate submission or replayed external event can never inflate results:
// every row is idempotent on dedupeKey, and corrections bump `revision` while
// keeping the previous actual in `previousActual`.
model KpiResult {
  id          String   @id @default(cuid())
  // Idempotency: "report:{reportId}:{kpiKey}" | "tl:{reportId}:{kpiKey}" |
  // "sbts:{eventId}" | "sbts:{eventId}:{component}"
  dedupeKey   String   @unique
  userId      String
  user        User     @relation("KpiResultOwner", fields: [userId], references: [id], onDelete: Cascade)
  team        String?
  department  String
  kpiKey      String
  label       String
  unit        String   @default("count") // count | percent | minutes | score
  target      Float?
  actual      Float?
  // Direction-aware achievement percent; null when target is unset (never faked)
  achievement Float?
  // MET | ON_TRACK | BELOW_TARGET | NO_TARGET (shortfall convention: <80%)
  statusLabel String?
  // REPORT (agent/social/tech report) | TL_REPORT (team lead's own template
  // metrics) | SBTS (external Media Command Centre score)
  source      String
  reportId    String?
  report      Report?  @relation("KpiResultSource", fields: [reportId], references: [id], onDelete: Cascade)
  sbtsEventId String?
  sbtsEvent   SbtsEvent? @relation("KpiResultEvent", fields: [sbtsEventId], references: [id], onDelete: SetNull)
  // The reporting day the value belongs to (UTC midnight) + "YYYY-MM" month key
  reportDate  DateTime
  periodMonth String
  // Mirrors the report workflow: SUBMITTED | APPROVED | REJECTED
  verification String  @default("SUBMITTED")
  // Correction history: bumped when a resubmitted report refreshes the row
  revision       Int      @default(1)
  previousActual Float?
  // Extraction provenance for values parsed out of external/structured reports
  // (SBTS Media Scoreboard text): HIGH = explicit Target|Actual|Variance row,
  // MEDIUM = arithmetic-derived (e.g. inline "5 (+4)" → target = actual−variance),
  // LOW = partially unparseable row kept for review. Manual rows leave it null.
  extractionConfidence String?
  // JSON evidence note: which source line/format the value came from, and why
  // a value is missing (e.g. "Actual not reported — incomplete extraction").
  evidence String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, reportDate])
  @@index([reportId])
  @@index([source, periodMonth])
  @@index([team, periodMonth])
}

model ReportTemplate {
  id          String   @id @default(cuid())
  // Template key, e.g. TEAM_LEAD
  key         String   @unique
  name        String
  description String?
  // JSON: { title, sections: [...] } — editable by administrators & supervisors
  definition  String
  updatedById String?
  updatedBy   User?    @relation("TemplateUpdater", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Master report templates — the ORIGINAL uploaded Word documents that serve as
// the design foundation for generated/downloaded reports. One active master per
// report type (AGENT_BPO | SUPERVISOR | TECH | SOCIAL | TEAM_LEAD). Generating a
// report fills a COPY of the master; the master file itself is never modified.
model ReportMasterTemplate {
  id            String   @id @default(cuid())
  reportType    String   @unique
  storedName    String   // file inside uploads-storage/
  originalName  String
  mimeType      String   @default("application/vnd.openxmlformats-officedocument.wordprocessingml.document")
  sizeBytes     Int
  fileHash      String   // sha256 of the master — proves the master is untouched
  updatedById   String?
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  department  String
  assigneeId  String?
  assignee    User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById String
  creator     User     @relation("TaskCreator", fields: [createdById], references: [id])
  category    String?
  projectRef  String?
  priority    String   @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  // NOT_STARTED | IN_PROGRESS | COMPLETED | UNDER_REVIEW | BLOCKED | PENDING_DEPLOYMENT | AWAITING_APPROVAL | NOT_COMPLETED
  status      String   @default("NOT_STARTED")
  requiredOutcome String?
  target      String?
  kpiKey      String?
  // Centre-based targeting: a task can be assigned to (a) an individual via
  // assigneeId, (b) every agent of one centre (centreCountry + centreState —
  // a centre is a state/region within a country), or (c) all centres at once
  // (allCentres = true). Individual assignments may also carry centre fields
  // as metadata when the admin picked them from a centre context.
  centreCountry String?
  centreState   String?
  allCentres    Boolean @default(false)
  dateAssigned DateTime @default(now())
  deadline    DateTime?
  estimatedHours Float?
  actualHours Float?
  blocker     String?
  nextSteps   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignees TaskAssignee[]

  @@index([assigneeId])
  @@index([department])
}

// Multi-assignee support for tasks (legacy Task.assigneeId kept for single assignments)
model TaskAssignee {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  // PENDING | IN_PROGRESS | COMPLETED
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taskId, userId])
  @@index([userId])
}

// Company-wide announcements posted by administrators — visible to every user
model Notice {
  id         String   @id @default(cuid())
  title      String
  body       String
  pinned     Boolean  @default(false)
  authorId   String?
  author     User?    @relation("NoticeAuthor", fields: [authorId], references: [id])
  authorName String?
  authorRole String?
  // Audience targeting: null centre + allCentres=false = company-wide (everyone);
  // centreCountry+centreState = one centre; teams (JSON array of team keys)
  // narrows a targeted centre to specific teams; allCentres=true = broadcast
  // to every centre (administrator only).
  centreCountry String?
  centreState   String?
  teams         String?
  allCentres    Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
}

model UploadedFile {
  id            String    @id @default(cuid())
  originalName  String
  storedName    String
  mimeType      String
  sizeBytes     Int
  fileHash      String
  // UPLOADED | PROCESSING | EXTRACTION_COMPLETED | AWAITING_CONFIRMATION | SUBMITTED | FAILED
  extractStatus String    @default("UPLOADED")
  extractError  String?
  extractedData String? // JSON mapped fields
  rawText       String?
  reportDate    DateTime?
  department    String?
  reportId      String?
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())
  // Text-only mode: the original file was deleted from storage after
  // extraction — rawText + extractedData remain as the permanent draft.
  fileDiscarded Boolean   @default(false)
  discardedAt   DateTime?

  @@index([userId])
  @@index([fileHash])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  severity  String   @default("INFO") // INFO | WARNING | CRITICAL
  title     String
  message   String
  linkData  String?
  read      Boolean  @default(false)
  dedupeKey String?  @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, read])
}

model KpiConfig {
  id            String  @id @default(cuid())
  department    String
  key           String
  label         String
  category      String // CORE_TEMPLATE | EMAIL_EXTENSION | TECH | SOCIAL
  unit          String  @default("count") // count | percent | minutes
  direction     String  @default("HIGHER_BETTER") // HIGHER_BETTER | LOWER_BETTER | DERIVED
  defaultTarget Float?
  derivedFrom   String? // formula key for auto-calculated metrics
  mandatory     Boolean @default(false)
  active        Boolean @default(true)
  sortOrder     Int     @default(0)
  // Centre scope: "ALL"/"ALL" = global default for the department;
  // ("NG","Lagos") etc. = centre-specific configuration that overrides the default.
  centreCountry String  @default("ALL")
  centreState   String  @default("ALL")

  @@unique([department, key, centreCountry, centreState])
}

// Notify / escalate bar — two-way messages between staff and management.
// Agents escalate to TEAM_LEAD / SUPERVISOR / ADMIN (always cc ADMIN);
// management can send a notice to any agent of their choice.
model Escalation {
  id          String   @id @default(cuid())
  fromId      String
  from        User     @relation("EscalationFrom", fields: [fromId], references: [id])
  fromName    String
  fromRole    String
  // TARGET_ROLE (route by role within centre) | TARGET_USER (direct) | ALL_MANAGEMENT
  targetType  String   @default("TARGET_ROLE")
  targetRole  String? // TEAM_LEAD | SUPERVISOR | ADMIN
  targetUserId String?
  targetUser  User?    @relation("EscalationTarget", fields: [targetUserId], references: [id])
  targetName  String?
  subject     String
  message     String
  severity    String   @default("NORMAL") // NORMAL | URGENT
  // OPEN | ACKNOWLEDGED | IN_PROGRESS | RESOLVED | REOPENED | CLOSED
  status      String   @default("OPEN")
  ackById     String?
  ackByName   String?
  ackNote     String?
  resolvedAt  DateTime?
  // Resolution / closure record (recipient must state what was done)
  resolutionNote String?
  resolvedById   String?
  resolvedByName String?
  closedAt       DateTime?
  // Author's centre/team snapshot at creation — keeps routing and filters stable
  centreCountry String?
  centreState   String?
  team          String?
  // Denormalized thread state for inbox unread badges and "last activity" sorting
  lastMessageAt        DateTime?
  lastMessageSenderId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages EscalationMessage[]
  events   EscalationEvent[]
  reads    EscalationRead[]

  @@index([fromId])
  @@index([status])
  @@index([createdAt])
  @@index([targetUserId])
}

// One message in an escalation's persistent conversation thread.
// The original Escalation.message is seeded as the first message on migration.
model EscalationMessage {
  id           String     @id @default(cuid())
  escalationId String
  escalation   Escalation @relation(fields: [escalationId], references: [id], onDelete: Cascade)
  senderId     String
  senderName   String
  senderRole   String
  body         String
  createdAt    DateTime   @default(now())

  @@index([escalationId, createdAt])
}

// Immutable activity timeline entry — status changes, acknowledgements,
// reassignments, resolutions. Actors and timestamps are recorded once and
// never edited afterwards.
model EscalationEvent {
  id           String     @id @default(cuid())
  escalationId String
  escalation   Escalation @relation(fields: [escalationId], references: [id], onDelete: Cascade)
  actorId      String?
  actorName    String
  actorRole    String?
  // CREATED | ACKNOWLEDGED | IN_PROGRESS | RESOLVED | REOPENED | CLOSED |
  // MESSAGE_SENT | REASSIGNED | PRIORITY_CHANGED | INFO_REQUESTED
  action       String
  details      String?
  createdAt    DateTime   @default(now())

  @@index([escalationId, createdAt])
}

// Per-user read cursor over an escalation thread — drives unread badges.
model EscalationRead {
  id           String     @id @default(cuid())
  escalationId String
  escalation   Escalation @relation(fields: [escalationId], references: [id], onDelete: Cascade)
  userId       String
  lastReadAt   DateTime   @default(now())

  @@unique([escalationId, userId])
  @@index([userId])
}

// ── Browser push notifications (Web Push / VAPID) ─────────────────────────
// Push endpoints and subscription keys are SENSITIVE: rows are only ever read
// through server-side API routes (session-checked); no client-facing query
// returns endpoint or key material.
model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  // Human-readable device/browser label shown in the user's settings list
  label         String    @default("Browser")
  // Web Push subscription endpoint URL (unique per browser subscription)
  endpoint      String    @unique
  p256dh        String
  auth          String
  // false once the push service reports 404/410 (expired/unsubscribed)
  active        Boolean   @default(true)
  lastSuccessAt DateTime?
  lastError     String?
  // EXPIRED | UNAUTHORIZED | PAYLOAD_TOO_LARGE | NETWORK | UNKNOWN
  lastErrorCategory String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User           @relation(fields: [userId], references: [id])
  deliveries  PushDelivery[]

  @@index([userId])
  @@index([active])
}

// One queued logical notification per intended recipient. Created by trusted
// server-side producers (via notify()), dispatched to the recipient's active
// subscriptions. Idempotency: dedupeKey (when present) is unique per recipient;
// claim/lease semantics prevent concurrent workers from double-processing.
model PushEvent {
  id          String    @id @default(cuid())
  userId      String
  type        String
  severity    String    @default("INFO")
  title       String
  body        String
  // Safe internal hash-route destination (allowlisted view names only)
  url         String    @default("#/notifications")
  relatedType String?
  relatedId   String?
  // PENDING | PROCESSING | SENT | FAILED | SKIPPED
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  lastError   String?
  // Lease: set to now+2min on claim so a crashed worker's lease expires
  nextAttemptAt DateTime @default(now())
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  dedupeKey   String?   @unique

  user       User           @relation(fields: [userId], references: [id])
  deliveries PushDelivery[]

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
}

// One row per (event × subscription × attempt) with the real push-service
// response. outcome: ACCEPTED | RETRY_LATER | FAILED | DEACTIVATED
model PushDelivery {
  id             String    @id @default(cuid())
  eventId        String
  subscriptionId String
  attempt        Int       @default(1)
  statusCode     Int?
  outcome        String
  error          String?
  retryEligible  Boolean   @default(false)
  nextRetryAt    DateTime?
  createdAt      DateTime  @default(now())

  event        PushEvent        @relation(fields: [eventId], references: [id])
  subscription PushSubscription @relation(fields: [subscriptionId], references: [id])

  @@index([eventId])
  @@index([subscriptionId])
}

// Per-user browser push preferences. pushEnabled=false silences all push
// except MANDATORY categories (administrator-defined, SystemFlag `push:mandatory`).
model PushPreference {
  userId      String   @id
  pushEnabled Boolean  @default(true)
  // JSON Record<category, boolean>; absent/false → default unless mandatory
  categories  String?
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  actorName String?
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
}

model SystemFlag {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
